{
  "name": "blog-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm images:generate",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "snapshot:content": "node scripts/snapshot-content.mjs && pnpm images:generate",
    "images:generate": "node scripts/generate-image-metadata.mjs",
    "lint": "eslint --cache --cache-location .cache/eslint/ src scripts next.config.js eslint.config.mjs",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "check": "pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "fast-xml-parser": "catalog:utils",
    "lucide-react": "catalog:ui",
    "next": "catalog:core",
    "next-mdx-remote": "catalog:content",
    "react": "catalog:core",
    "react-dom": "catalog:core",
    "remark-gfm": "catalog:content",
    "sharp": "0.34.5",
    "zod": "catalog:utils"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "eslint": "catalog:tooling",
    "eslint-config-next": "catalog:tooling",
    "playwright-core": "1.58.2",
    "typescript": "catalog:tooling"
  },
  "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.16",
      "@types/react-dom": "19.2.3"
    }
  }
}
